[Unit]
Description=agentRx FastAPI (pharmacy stock + shortage board)
After=network.target

[Service]
Type=simple
User=agentrx
Group=agentrx
WorkingDirectory=/opt/agentrx
EnvironmentFile=/opt/agentrx/.env
ExecStart=/opt/agentrx/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
# SQLite lives at $AGENTRX_DB_PATH (default /opt/agentrx/agentrx.db); keep it on the EBS volume.
# Logs go to journald: journalctl -u agentrx -f

[Install]
WantedBy=multi-user.target
