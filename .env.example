# AWS Bedrock (Strands agent LLM; blank = deterministic passthrough)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# alt: anthropic.claude-3-haiku-20240307-v1:0

# Google Places API (New) — enable "Places API (New)" + billing on the key.
# Restrict the key to Places API. Blank = mock pharmacies.
GOOGLE_PLACES_API_KEY=

# CALL-E telephony (blank = mock calls; docs: github.com/CALLE-AI/call-e-integrations)
# key from https://dashboard.heycall-e.com/account/api-keys (new users: 20 free calls)
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Demo mode: AGENTRX_MOCK=1 forces mock pharmacies + mock calls even with live
# keys set (use for the video, or where CALL-E has no coverage, e.g. Nigeria
# +234 — not in CALL-E's supported countries). Any drug returns a demo
# response; select the demo storefront to call just it.
AGENTRX_MOCK=
# Comma-separated drug-name substrings that always come back out-of-stock in
# mock mode, so the human-handoff path is demoable (e.g. AGENTRX_MOCK_OOS=shortage-demo).
AGENTRX_MOCK_OOS=

# Demo storefront: always injected as the first pharmacy candidate so the live
# call goes to a phone you control. E.164 format, e.g. +15551234567
DEMO_STOREFRONT_PHONE=
DEMO_STOREFRONT_NAME=AgentRx Demo Pharmacy

# Refill pings (blank = console print)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email summaries (blank = 501 "not configured", chat shows copy-paste fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CARTO raster basemap key (removes tile watermark; free tier)
CARTO_API_KEY=

AGENTRX_DB_PATH=./agentrx.db
